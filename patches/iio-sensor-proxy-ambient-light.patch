+/* One global light reading is exported by the D-Bus API. Prefer an explicitly
+ * ranked external sensor, retain it across equal-priority hotplugs, and keep
+ * client claims alive when switching back to an already present laptop ALS. */
+static gint
+light_device_compare (gconstpointer a, gconstpointer b, gpointer user_data)
+{
+	SensorData *data = user_data;
+	GUdevDevice *left = (GUdevDevice *) a, *right = (GUdevDevice *) b;
+	gint lp = g_udev_device_get_property_as_int (left, "IIO_SENSOR_PROXY_LIGHT_PRIORITY");
+	gint rp = g_udev_device_get_property_as_int (right, "IIO_SENSOR_PROXY_LIGHT_PRIORITY");
+	const char *lpath = g_udev_device_get_sysfs_path (left);
+	const char *rpath = g_udev_device_get_sysfs_path (right);
+	GUdevDevice *current = UDEV_DEVICE_FOR_TYPE(DRIVER_TYPE_LIGHT);
+
+	if (lp != rp)
+		return lp > rp ? -1 : 1;
+	if (current) {
+		const char *path = g_udev_device_get_sysfs_path (current);
+		if (g_str_equal (lpath, path))
+			return g_str_equal (rpath, path) ? 0 : -1;
+		if (g_str_equal (rpath, path))
+			return 1;
+	}
+	return g_strcmp0 (lpath, rpath);
+}
+
+static void
+refresh_light_sensor (SensorData *data, const char *removed_path)
+{
+	GList *devices = NULL, *l;
+	const char *subsystems[] = { "iio", "input", "platform", "misc" };
+	GUdevDevice *chosen = NULL, *current = UDEV_DEVICE_FOR_TYPE(DRIVER_TYPE_LIGHT);
+	SensorDriver *chosen_driver = NULL;
+	SensorDevice *opened = NULL;
+	guint i;
+
+	for (i = 0; i < G_N_ELEMENTS(subsystems); i++)
+		devices = g_list_concat (devices, g_udev_client_query_by_subsystem (data->client, subsystems[i]));
+	devices = g_list_sort_with_data (devices, light_device_compare, data);
+	for (l = devices; l != NULL; l = l->next) {
+		GUdevDevice *dev = l->data;
+		const char *path = g_udev_device_get_sysfs_path (dev);
+
+		if (g_strcmp0 (path, removed_path) == 0)
+			continue;
+		/* Do not probe (and disable) an in-use ring buffer on every uevent. */
+		if (current && g_str_equal (path, g_udev_device_get_sysfs_path (current)) &&
+		    g_strcmp0 (g_udev_device_get_property (dev, "IIO_SENSOR_PROXY_TYPE"),
+			       g_udev_device_get_property (current, "IIO_SENSOR_PROXY_TYPE")) == 0) {
+			g_set_object (&UDEV_DEVICE_FOR_TYPE(DRIVER_TYPE_LIGHT), dev);
+			g_list_free_full (devices, g_object_unref);
+			return;
+		}
+		for (i = 0; i < G_N_ELEMENTS(drivers); i++) {
+			SensorDriver *driver = (SensorDriver *) drivers[i];
+			if (driver->type != DRIVER_TYPE_LIGHT || !driver_discover (driver, dev))
+				continue;
+			opened = driver_open (driver, dev, light_changed_func, data);
+			if (opened) {
+				chosen = g_object_ref (dev);
+				chosen_driver = driver;
+				break;
+			}
+		}
+		if (opened)
+			break;
+	}
+	g_list_free_full (devices, g_object_unref);
+
+	if (DEVICE_FOR_TYPE(DRIVER_TYPE_LIGHT)) {
+		driver_set_polling (DEVICE_FOR_TYPE(DRIVER_TYPE_LIGHT), FALSE);
+		driver_close (DEVICE_FOR_TYPE(DRIVER_TYPE_LIGHT));
+	}
+	g_clear_object (&UDEV_DEVICE_FOR_TYPE(DRIVER_TYPE_LIGHT));
+	UDEV_DEVICE_FOR_TYPE(DRIVER_TYPE_LIGHT) = chosen;
+	DRIVER_FOR_TYPE(DRIVER_TYPE_LIGHT) = chosen_driver;
+	DEVICE_FOR_TYPE(DRIVER_TYPE_LIGHT) = opened;
+	data->previous_level = 0.0;
+	data->uses_lux = TRUE;
+	data->sensor_startup_dbus_event_delayed[DRIVER_TYPE_LIGHT] = FALSE;
+	if (opened) {
+		data->light_seen = TRUE;
+		g_debug ("Selected ambient light sensor %s (priority %d)",
+			 g_udev_device_get_sysfs_path (chosen),
+			 g_udev_device_get_property_as_int (chosen, "IIO_SENSOR_PROXY_LIGHT_PRIORITY"));
+		if (g_hash_table_size (data->clients[DRIVER_TYPE_LIGHT]) > 0) {
+			data->sensor_startup_dbus_event_delayed[DRIVER_TYPE_LIGHT] = TRUE;
+			driver_set_polling (opened, TRUE);
+			return;
+		}
+	} else {
+		/* ClaimLight is valid even with no sensor. Keep those claims so a
+		 * replacement can start without GNOME having to claim again. */
+		maybe_notify_sensor_startup_finished (data, DRIVER_TYPE_LIGHT);
+	}
+	send_driver_changed_dbus_event (data, DRIVER_TYPE_LIGHT);
+}
