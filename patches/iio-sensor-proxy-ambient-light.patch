+
+    def add_light(self, name, raw, priority=0, scale='1.0', override=None):
+        props = ['IIO_SENSOR_PROXY_TYPE', 'iio-poll-als',
+                 'IIO_SENSOR_PROXY_LIGHT_PRIORITY', str(priority)]
+        if override is not None:
+            props += ['IIO_SENSOR_PROXY_LIGHT_SCALE', override]
+        return self.testbed.add_device('iio', name, None,
+            ['in_illuminance_raw', str(raw), 'in_illuminance_scale', scale,
+             'in_illuminance_integration_time', '0.05'], props)
+
+    def assert_lux(self, value):
+        self.assertEventually(lambda: abs(self.get_dbus_property('LightLevel') - value) < 0.0001)
+        self.assertEqual(self.get_dbus_property('LightLevelUnit'), 'lux')
+
+    def test_light_desktop_one_display(self):
+        self.add_light('studio', 24000, 100, override='0.001')
+        self.start_daemon()
+        self.proxy.ClaimLight()
+        self.assert_lux(24)
+
+    def test_light_laptop_open_and_closed_with_display(self):
+        laptop = self.add_light('laptop', 80)
+        self.add_light('studio', 24000, 100, override='0.001')
+        self.start_daemon()
+        self.proxy.ClaimLight()
+        self.assert_lux(24)
+        self.testbed.set_attribute(laptop, 'in_illuminance_raw', '0')
+        self.testbed.uevent(laptop, 'change')
+        self.assert_lux(24)
+
+    def test_light_laptop_only(self):
+        self.add_light('laptop', 80)
+        self.start_daemon()
+        self.proxy.ClaimLight()
+        self.assert_lux(80)
+
+    def test_light_dock_undock_and_redock_preserve_claim(self):
+        laptop = self.add_light('laptop', 0)
+        self.start_daemon()
+        self.proxy.ClaimLight()
+        self.assert_lux(0)
+        studio = self.add_light('studio', 24000, 100, override='0.001')
+        self.assert_lux(24)
+        self.testbed.remove_device(studio)
+        self.assert_lux(0)
+        self.assertTrue(self.get_dbus_property('HasAmbientLight'))
+        self.testbed.set_attribute(laptop, 'in_illuminance_raw', '80')
+        self.assert_lux(80)
+        self.add_light('studio', 30000, 100, override='0.001')
+        self.assert_lux(30)
+
+    def test_light_desktop_last_unplug_and_replug_preserve_claim(self):
+        studio = self.add_light('studio', 24000, 100, override='0.001')
+        self.start_daemon()
+        self.proxy.ClaimLight()
+        self.assert_lux(24)
+        self.testbed.remove_device(studio)
+        self.assertEventually(lambda: not self.get_dbus_property('HasAmbientLight'))
+        self.assertEqual(self.daemon.poll(), None)
+        self.assert_lux(0)
+        self.add_light('studio', 36000, 100, override='0.001')
+        self.assert_lux(36)
+
