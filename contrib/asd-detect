#!/usr/bin/env python3
"""List Studio Display USB and video identities without changing the displays.

Connect one physical Studio Display at a time to obtain a display_map pair.
Keep all its video/USB cables attached. Multiple DP tiles share one EDID serial.
"""

import argparse
import json
from pathlib import Path


def read(path):
    try:
        return path.read_text().strip()
    except OSError:
        return ""


def inventory(sysfs=Path("/sys")):
    usb = []
    for path in sorted((sysfs / "bus/usb/devices").glob("*")):
        if (read(path / "idVendor") != "05ac"
                or read(path / "idProduct") not in ("1114", "1116")):
            continue
        usb.append({"device": path.name, "serial": read(path / "serial"),
                    "product": read(path / "product")})

    video = []
    for path in sorted((sysfs / "class/drm").glob("card*-*")):
        if read(path / "status") != "connected":
            continue
        try:
            edid = (path / "edid").read_bytes()
        except OSError:
            continue
        if len(edid) < 128 or edid[8:10] != b"\x06\x10":
            continue
        names = [edid[i + 5:i + 18].decode("ascii", errors="replace").strip()
                 for i in range(54, 126, 18)
                 if edid[i:i + 5] == b"\0\0\0\xfc\0"]
        if not any(name.startswith("Studio") for name in names):
            continue
        video.append({"connector": path.name, "name": names[0],
                      "serial": f"{int.from_bytes(edid[12:16], 'little'):08x}",
                      "enabled": read(path / "enabled") == "enabled"})
    return {"usb": usb, "video": video}


def single_pair(devices):
    # Never assign two identical models by enumeration order. The user must
    # isolate a physical display; equal EDID serials can also mean duplicates.
    serials = {v["serial"] for v in devices["video"]}
    if len(devices["usb"]) == 1 and len(serials) == 1:
        usb = devices["usb"][0]["serial"]
        edid = next(iter(serials))
        if usb and edid != "00000000":
            return f"{usb}:{edid}"
    return None


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--json", action="store_true", help="print machine-readable inventory")
    args = parser.parse_args()
    devices = inventory()
    if args.json:
        print(json.dumps(devices, indent=2))
        return
    for device in devices["usb"]:
        print(f"USB {device['device']}: {device['product']} serial={device['serial']}")
    for device in devices["video"]:
        state = "enabled" if device["enabled"] else "disabled"
        print(f"DRM {device['connector']}: {device['name']} "
              f"EDID serial={device['serial']} ({state})")
    pair = single_pair(devices)
    if pair:
        print("\nWith only this physical Studio Display connected, its mapping is:")
        print(f"display_map={pair}")
    else:
        print("\nConnect one physical Studio Display at a time to obtain each mapping.")


if __name__ == "__main__":
    main()
