# Desktop integration for hid-apple-studio-display.

# Some models have two ambient light sensors, front and rear, and
# iio-sensor-proxy would take whichever it enumerates first (the rear one),
# making GNOME's automatic brightness follow the wall behind the monitor.
# Hide the rear sensor from it. asd-als-role tells the two apart by their
# order within the display's HID device. A sole sensor must remain exposed.
ACTION=="add|change", SUBSYSTEM=="iio", KERNELS=="0003:05AC:1114.*|0003:05AC:1116.*", ATTR{name}=="als", \
  PROGRAM="/usr/lib/udev/asd-als-role %p", ENV{ASD_ALS_ROLE}="%c"
ACTION=="add|change", SUBSYSTEM=="iio", ENV{ASD_ALS_ROLE}=="rear", ENV{IIO_SENSOR_PROXY_TYPE}=""
# These two properties are consumed by the patched iio-sensor-proxy in patches/.
ACTION=="add|change", SUBSYSTEM=="iio", ENV{ASD_ALS_ROLE}=="single|front", \
  ENV{IIO_SENSOR_PROXY_LIGHT_PRIORITY}="100", ENV{IIO_SENSOR_PROXY_LIGHT_SCALE}="0.001"
# An early sole sensor may acquire a sibling while the USB device enumerates.
ACTION=="add", SUBSYSTEM=="iio", ENV{ASD_ALS_ROLE}=="single|front|rear", \
  RUN+="/usr/bin/udevadm trigger --action=change --subsystem-match=iio"

# The orientation sensor lives on a HID sensor-hub interface that both
# hid-sensor-hub and hid-apple-studio-display match; which one wins at
# enumeration is a race. Once the drivers are loaded, hand the interface to
# hid-apple-studio-display (the only one that can read its 9-bit fields).
ACTION=="add", SUBSYSTEM=="hid", ENV{MODALIAS}=="hid:b0003g0003v000005ACp0000111[46]", \
  RUN+="/usr/lib/udev/asd-bind-orientation %k"
